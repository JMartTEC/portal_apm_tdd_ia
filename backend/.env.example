# Copia este archivo como ".env" (junto a este mismo, dentro de backend/).
# No subir el .env real al repositorio -- ya está en .gitignore.

# local | claude | (vacio = automatico)
AI_MODO=local

# --- Modo local, sin API key. Requiere Ollama corriendo -------------------
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MAX_CHARS=18000

# --- Modo API -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Obligatorio si el token esta ligado a una identidad de organizacion.
ANTHROPIC_WORKSPACE_ID=
